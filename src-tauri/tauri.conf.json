{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh_shell",
  "version": "0.1.26",
  "identifier": "com.dsh-ui.app",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "target/release/WebView2Loader.dll": "WebView2Loader.dll",
      "../README.md": "README.md"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "template": "nsis/installer.nsi",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
